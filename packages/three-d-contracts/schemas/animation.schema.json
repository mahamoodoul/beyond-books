          },
          {
            "$ref": "#/$defs/FlowParticlesStep"
          },
          {
            "$ref": "#/$defs/CameraFocusStep"
          },
          {
            "$ref": "#/$defs/AnnotationStep"
          },
          {
            "$ref": "#/$defs/WaitStep"
          }
        ]
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "animation_id",
    "title",
