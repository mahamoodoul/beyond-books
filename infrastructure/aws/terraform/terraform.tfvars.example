# Copy to terraform.tfvars (git-ignored) and fill in. Everything else has sensible defaults.

region        = "eu-north-1"
environment   = "dev"
instance_type = "t3.xlarge" # 4 vCPU / 16 GB: whole stack incl. Blender. t3.large without Blender.

# Access: leave admin_cidr empty to use SSM Session Manager only (no SSH, no keys).
admin_cidr     = ""   # e.g. "84.212.10.20/32"
ssh_public_key = ""   # e.g. "ssh-ed25519 AAAA... you@laptop"

# Public address: a domain you own (Caddy issues TLS) or empty for http://<elastic-ip> (demo only).
domain         = ""   # e.g. "app.beyondbooks.no"
hosted_zone_id = ""   # Route 53 zone id if AWS hosts the DNS; else create the A record yourself

# Features
enable_blender = true
demo_mode      = true
seed_demo_data = true

# AI (empty key = offline fake providers)
anthropic_api_key  = "sk-ant-..."
anthropic_model    = "claude-opus-5-5"
elevenlabs_api_key = ""

# Money: AWS Budgets emails at 50 / 80 / 100 % of this per month
budget_alert_email = "you@example.com"
monthly_budget_usd = 20

# CI/CD: GitHub repository allowed to deploy through OIDC (empty disables the role).
# github_repository      = "mahamoodoul/beyond-books"
# github_deploy_branches = ["aws-dev"]
# github_oidc_provider_arn = ""   # set if the account already has token.actions.githubusercontent.com
