# Copy to .env for local development. Never commit real secrets.
EDU3D_ENVIRONMENT=local
EDU3D_DATABASE_URL=postgresql+psycopg://edu3d:edu3d@localhost:5432/edu3d
EDU3D_REDIS_URL=redis://localhost:6379/0
EDU3D_CORS_ORIGINS=["http://localhost:5173"]

# Auth — set a long random secret outside local dev; cookies must be Secure in staging/prod
EDU3D_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
EDU3D_COOKIE_SECURE=false
EDU3D_OPEN_REGISTRATION=true

# Postgres container credentials (local only)
POSTGRES_USER=edu3d
POSTGRES_PASSWORD=edu3d
POSTGRES_DB=edu3d

# Jobs: true runs extraction/AI in-process (no Redis/worker needed)
EDU3D_JOBS_RUN_INLINE=false

# Storage: local (dev) or s3 (pilot)
EDU3D_STORAGE_BACKEND=local
EDU3D_LOCAL_STORAGE_DIR=./.storage
# EDU3D_S3_BUCKET=
# EDU3D_S3_REGION=eu-north-1

# ============================================================================
# AI PROVIDERS — pick one LLM and one 3D provider; fill ONLY the keys you use.
# Names are validated at startup against backend/app/integrations/providers.py.
# Adding a new vendor: see docs/ADDING_A_PROVIDER.md (no other config changes).
# Switching model = change the *_MODEL line; no code change.
# ============================================================================
# LLM provider: fake (offline) | anthropic (Claude) | openai (or OpenAI-compatible)
EDU3D_LLM_PROVIDER=fake

# --- anthropic (Claude) ---
EDU3D_ANTHROPIC_API_KEY=
EDU3D_ANTHROPIC_MODEL=claude-opus-5-5
# effort: low | medium | high | xhigh | max (raise for better lessons, lower for cost)
EDU3D_ANTHROPIC_EFFORT=medium

# --- openai (also any OpenAI-compatible endpoint via base URL) ---
EDU3D_OPENAI_API_KEY=
EDU3D_OPENAI_MODEL=
EDU3D_OPENAI_BASE_URL=

# Cost estimates (USD per 1M tokens) for the SELECTED model; leave 0 to show no estimate.
# Claude Opus 5.5 list price: 4 input / 20 output.
EDU3D_LLM_INPUT_PRICE_PER_MTOK=0
EDU3D_LLM_OUTPUT_PRICE_PER_MTOK=0
EDU3D_LLM_MAX_OUTPUT_TOKENS=8000
EDU3D_AI_MAX_JOBS_PER_COURSE_PER_DAY=40

# 3D provider: llm (AI designs the model from primitives, rendered by three.js) | fake (offline) | tripo | meshy (tripo/meshy adapters pending verification)
EDU3D_THREE_D_PROVIDER=fake
EDU3D_TRIPO_API_KEY=
EDU3D_MESHY_API_KEY=
EDU3D_THREE_D_MAX_GENERATIONS_PER_USER_PER_DAY=5
# "blender" 3D provider (local/dev only): Claude builds models in your running Blender via
# Blender MCP. See docs/BLENDER_MCP.md. Uses EDU3D_ANTHROPIC_API_KEY.
EDU3D_BLENDER_MCP_COMMAND=uvx mcp-for-blender
EDU3D_BLENDER_HOST=localhost
EDU3D_BLENDER_PORT=9876
EDU3D_BLENDER_MODEL=
EDU3D_BLENDER_MAX_TURNS=40
EDU3D_BLENDER_TIMEOUT_S=540
