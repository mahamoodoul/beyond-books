  "explanations": {
    "explanation_aorta": "The aorta is the largest artery. It carries oxygen-rich blood from the left ventricle to the rest of the body.",
    "explanation_inferior_vena_cava": "The inferior vena cava returns oxygen-poor blood from the lower body to the right atrium.",
    "explanation_left_atrium": "The left atrium receives oxygen-rich blood returning from the lungs through the pulmonary veins.",
    "explanation_left_ventricle": "The left ventricle has the thickest muscular wall because it pumps oxygen-rich blood to the whole body through the aorta.",
    "explanation_pulmonary_trunk": "The pulmonary trunk carries oxygen-poor blood from the right ventricle towards the lungs, where it picks up oxygen.",
    "explanation_pulmonary_veins": "The pulmonary veins bring oxygen-rich blood from the lungs back to the left atrium.",
    "explanation_right_atrium": "The right atrium receives oxygen-poor blood returning from the body through the superior and inferior vena cava.",
    "explanation_right_ventricle": "The right ventricle pumps oxygen-poor blood into the pulmonary trunk, which carries it to the lungs.",
    "explanation_superior_vena_cava": "The superior vena cava returns oxygen-poor blood from the head, neck and arms to the right atrium."
  },
