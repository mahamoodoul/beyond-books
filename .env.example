# Copy to .env for local development. Never commit real secrets.
EDU3D_ENVIRONMENT=local
EDU3D_DATABASE_URL=postgresql+psycopg://edu3d:edu3d@localhost:5432/edu3d
EDU3D_REDIS_URL=redis://localhost:6379/0
EDU3D_CORS_ORIGINS=["http://localhost:5173"]

# Postgres container credentials (local only)
POSTGRES_USER=edu3d
POSTGRES_PASSWORD=edu3d
POSTGRES_DB=edu3d

# Provider keys — added in later phases, stored in Secrets Manager outside local dev
# EDU3D_OPENAI_API_KEY=
# EDU3D_TRIPO_API_KEY=
# EDU3D_MESHY_API_KEY=
