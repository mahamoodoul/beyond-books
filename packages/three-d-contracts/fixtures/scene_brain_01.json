  "explanations": {
    "explanation_frontal_lobe": "The frontal lobe plans and controls voluntary movement, makes decisions, solves problems and helps produce speech.",
    "explanation_parietal_lobe": "The parietal lobe processes touch, temperature, pain and body position, and helps us judge size, shape and distance.",
    "explanation_temporal_lobe": "The temporal lobes process hearing, help us understand language and play a key part in forming memories.",
    "explanation_occipital_lobe": "The occipital lobe at the back of the brain is the main centre for processing what we see.",
    "explanation_cerebellum": "The cerebellum coordinates movement, balance and posture so that actions are smooth and accurate.",
    "explanation_brainstem": "The brainstem links the brain to the spinal cord and controls automatic functions such as breathing, heart rate and swallowing."
  }
