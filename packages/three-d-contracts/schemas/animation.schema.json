    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "steps": {
      "items": {
        "discriminator": {
          "mapping": {
            "camera_focus": "#/$defs/CameraFocusStep",
            "highlight_component": "#/$defs/HighlightStep",
            "move_along_path": "#/$defs/MoveAlongPathStep",
            "rotate_component": "#/$defs/RotateComponentStep",
            "set_opacity": "#/$defs/SetOpacityStep",
            "set_visibility": "#/$defs/SetVisibilityStep",
            "show_annotation": "#/$defs/AnnotationStep",
            "show_flow_particles": "#/$defs/FlowParticlesStep",
            "wait": "#/$defs/WaitStep"
          },
          "propertyName": "action"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/HighlightStep"
          },
          {
            "$ref": "#/$defs/SetVisibilityStep"
          },
          {
            "$ref": "#/$defs/SetOpacityStep"
          },
          {
            "$ref": "#/$defs/MoveAlongPathStep"
          },
          {
